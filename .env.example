# Copy this file to ".env". Never commit ".env". Nothing here needs a paid key.

# --- Mode ---------------------------------------------------------------------
# nllb   = (default) chat model answers in ENGLISH; local translators convert the
#          question and the answer. Runs fully on your computer.
# direct = the chat model writes Dzongkha itself (usually much worse with small
#          local models). Needs a strong model such as Gemini.
PIPELINE_MODE=nllb

# --- Chat model (English) ------------------------------------------------------
# Tried in order; a later one is used only if the earlier one fails.
# Allowed: ollama, gemini, openai_compat
PROVIDER_ORDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Local translators (pipeline mode) -----------------------------------------
# cst  = CST (Bhutan) NLLB fine-tunes from Hugging Face, one per direction.
# nllb = Meta's stock NLLB-200-distilled-600M (both directions).
# Neither is verified to be GovTech's model. Order = preference.
TRANSLATOR_ORDER=cst,nllb
CST_EN_TO_DZ_MODEL=KarmaCST/nllb-200-distilled-600M-en-to-dz
CST_DZ_TO_EN_MODEL=KarmaCST/nllb-200-distilled-600M-dz-to-en
NLLB_STOCK_MODEL=facebook/nllb-200-distilled-600M
# cpu (safe default, leaves the 4 GB GPU to Ollama) | cuda | auto
TRANSLATE_DEVICE=cpu
# Set true after the first download to forbid any network access to Hugging Face.
TRANSLATE_LOCAL_FILES_ONLY=false
TRANSLATE_BEAMS=4
# Longest message/answer, counted in sentences. Longer text gives a clean error.
TRANSLATE_MAX_SENTENCES=40

# --- Optional: free Gemini as the chat model (better answers, needs internet) ---
# Add "gemini" at the front of PROVIDER_ORDER to use it. Free tier only: do NOT
# enable billing on the project. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_USE_GOOGLE_SEARCH=true

# --- Optional: another free OpenAI-compatible provider -------------------------
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# --- Optional: Google Cloud Translation, direct mode only (OFF) -----------------
# Needs a billing-enabled Google Cloud project. Leave off.
ENABLE_GOOGLE_TRANSLATE=false
GOOGLE_TRANSLATE_API_KEY=
TRANSLATE_IF_DZONGKHA_RATIO_BELOW=0.5
TRANSLATE_MONTHLY_CHAR_BUDGET=400000

# --- Cost / size controls --------------------------------------------------------
MAX_HISTORY_TURNS=8
MAX_MESSAGE_CHARS=1500
MAX_OUTPUT_TOKENS=1024
TEMPERATURE=0.2
REQUEST_TIMEOUT_SECONDS=60
RATE_LIMIT_COOLDOWN_SECONDS=60
